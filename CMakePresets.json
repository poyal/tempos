{
  "version": 3,
  "configurePresets": [
    { "name": "release", "generator": "Ninja", "binaryDir": "${sourceDir}/out/release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON" } },
    { "name": "debug", "inherits": "release", "binaryDir": "${sourceDir}/out/debug", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "asan", "inherits": "debug", "binaryDir": "${sourceDir}/out/asan", "cacheVariables": { "TEMPOS_ASAN": "ON" } }
  ],
  "buildPresets": [{ "name": "release", "configurePreset": "release" }, { "name": "debug", "configurePreset": "debug" }, { "name": "asan", "configurePreset": "asan" }],
  "testPresets": [{ "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }, { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }]
}
