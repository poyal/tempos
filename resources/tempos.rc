#include <windows.h>
#include "version.h"
101 ICON "tempos.ico"
1 VERSIONINFO
 FILEVERSION TEMPOS_VERSION_NUMBERS
 PRODUCTVERSION TEMPOS_VERSION_NUMBERS
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Tempos"
   VALUE "FileDescription", "Tempos desktop widgets"
   VALUE "FileVersion", TEMPOS_VERSION_STRING
   VALUE "ProductName", "Tempos"
   VALUE "ProductVersion", TEMPOS_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
